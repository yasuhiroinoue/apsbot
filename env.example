
# .env.example

# Discord webhook URLs for posting updates (comma-separated)
WEBHOOK_URLS=https://discord.com/api/webhooks/your_webhook_url1,https://discord.com/api/webhooks/your_webhook_url2

# Gemini model identifier (via Vertex AI)
MODEL=gemini-flash-lite-latest

# Google Cloud region for Vertex AI (e.g. "global", "us-central1")
REGION=global

# Google Cloud project ID
PROJECT_ID=your_project_id

# Path to store the last processed date from the RSS feed
DATE_FILE_PATH=path_to_store_last_processed_date.txt

# RSS feed URL from American Physical Society's Physical Review Journals
RSS_URL=http://feeds.aps.org/rss/allsuggestions.xml
